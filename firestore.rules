rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStudent() {
      return isSignedIn() && request.auth.token.get('role', '') == 'student';
    }

    function studentOkulNo() {
      return request.auth.token.get('okulNo', '');
    }

    function isCourseTeacher(courseId) {
      return isSignedIn()
        && !isStudent()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /sharedSeatingPlans/{planId} {
      allow read: if isSignedIn() && !isStudent();
      allow create: if isSignedIn() && !isStudent()
        && request.auth.uid == request.resource.data.teacherId;
      allow update: if isSignedIn() && !isStudent()
        && request.auth.uid == resource.data.teacherId;
      allow delete: if isSignedIn() && !isStudent()
        && request.auth.uid == resource.data.teacherId;
    }

    match /classes/{classId} {
      allow read, write: if isSignedIn() && !isStudent()
        && request.auth.uid == resource.data.teacherId;

      allow create: if isSignedIn() && !isStudent()
        && request.auth.uid == request.resource.data.teacherId;

      match /students/{studentId} {
        allow read, write: if isSignedIn() && !isStudent()
          && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    match /courses/{courseId} {
      // Liste sorgusu resource.data ile uyumlu olmalı; get() tüm ders listesini düşürür.
      allow read, write: if isSignedIn() && !isStudent()
        && request.auth.uid == resource.data.teacherId;

      allow create: if isSignedIn() && !isStudent()
        && request.auth.uid == request.resource.data.teacherId;

      match /students/{studentId} {
        allow read, write: if isCourseTeacher(courseId);

        match /portal/{docId} {
          allow read: if isCourseTeacher(courseId)
            || (isStudent() && resource.data.okulNo == studentOkulNo());
          allow write: if isCourseTeacher(courseId);
        }
      }

      match /applications/{appId} {
        allow read, write: if isCourseTeacher(courseId);

        match /scores/{scoreId} {
          allow read, write: if isCourseTeacher(courseId);
        }
      }
    }

    match /timetables/{timetableId} {
      allow read, write: if isSignedIn() && !isStudent();
    }

    match /studentLogins/{okulNo} {
      allow read, write: if false;
    }

    match /studentLoginAttempts/{okulNo} {
      allow read, write: if false;
    }

    match /studentDashboards/{okulNo} {
      allow read: if (isStudent() && studentOkulNo() == okulNo)
        || (isSignedIn() && !isStudent() && request.auth.uid in resource.data.teacherIds);
      allow write: if isSignedIn() && !isStudent()
        && request.auth.uid in request.resource.data.teacherIds;
    }
  }
}
